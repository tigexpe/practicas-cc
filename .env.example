# Copia este archivo a .env y ajusta los valores. No subas .env al repositorio.
PUBLIC_BASE_URL=http://localhost:8000

# La contraseña va dentro de una URL de conexión: usa solo letras, números, "-" o "_".
# Postgres solo aplica estos valores al crear el volumen por primera vez.
POSTGRES_USER=app
POSTGRES_PASSWORD=cambia_esta_clave
# Base de datos del servicio shortener (no uses "analytics": esa la crea init.sql).
POSTGRES_DB=shortener

CODE_LENGTH=7
CACHE_TTL_SECONDS=3600
